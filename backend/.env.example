# =============================================================================
# Meet 后端配置示例
# 完整链路：上传音频 → 百炼ASR → DeepSeek槽位提取 → 高德MCP碰面推荐
# =============================================================================

# ── 应用 ──
APP_HOST=0.0.0.0
APP_PORT=8007
APP_RELOAD=true
STORAGE_DIR=Storage
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:5175,https://haozh0301-blip.github.io

# ── 链路开关 ──
PIPELINE_ASR_ENABLED=true
PIPELINE_SLOT_ENABLED=true
PIPELINE_AMAP_ENABLED=true
PIPELINE_ANSWER_ENABLED=true
PIPELINE_TTS_ENABLED=true

# ── 1. 百炼 ASR ──
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_ASR_MODEL=qwen3-asr-flash
BAILIAN_ASR_LANGUAGE=zh
BAILIAN_ASR_ENABLE_ITN=false
BAILIAN_ASR_STREAM=false
BAILIAN_ASR_MAX_BASE64_MB=10

# ── 2. DeepSeek 槽位提取 ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1024

# ── 4. DeepSeek 回答生成 ──
DEEPSEEK_ANSWER_MODEL=deepseek-chat
DEEPSEEK_ANSWER_TEMPERATURE=0.7
DEEPSEEK_ANSWER_MAX_TOKENS=2048

# ── 5. 百炼 TTS ──
BAILIAN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
BAILIAN_TTS_LANGUAGE_TYPE=Chinese

# ── 3. 高德 MCP ──
AMAP_MCP_ENABLED=true
AMAP_MCP_SERVER_BASE=https://mcp.amap.com/mcp
AMAP_MCP_URL=
AMAP_MAPS_API_KEY=your-amap-key
AMAP_WEB_SERVICE_KEY=
AMAP_MCP_TIMEOUT_SECONDS=120
AMAP_MCP_DISTANCE_TYPE=0
AMAP_HTTP_GEOCODE_FALLBACK=true
AMAP_GEOCODE_DEFAULT_CITY=北京
AMAP_MEET_POI_KEYWORDS=商场|咖啡厅|地铁站
AMAP_MEET_POI_RADIUS=3000
AMAP_MEET_CANDIDATE_LIMIT=3
AMAP_DIRECTION_TOOL=maps_direction_driving
